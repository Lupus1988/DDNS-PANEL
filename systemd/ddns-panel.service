[Unit]
Description=DDNS Panel
After=network-online.target
Wants=network-online.target

[Service]
User=root
WorkingDirectory=/opt/ddns-panel
Environment=PYTHONPATH=/opt/ddns-panel
ExecStart=/opt/ddns-panel/venv/bin/python /opt/ddns-panel/panel/app.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
